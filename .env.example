# Copier en `.env` (lu automatiquement par docker compose) ou poser ces
# variables dans l'onglet Environment de Dokploy.
#
# Toutes ont un défaut adapté aux deux compose : en local comme sur Dokploy, la
# pile démarre sans en poser aucune.

# URL du parallaxe telle que le STUDIO la joint CÔTÉ SERVEUR, par le réseau
# interne (le navigateur, lui, n'appelle que /api/parallax/* sur le studio).
# Défaut = nom de service compose du parallaxe. C'est une variable de RUNTIME :
# la changer ne demande pas de reconstruire le studio.
PARALLAX_INTERNAL_URL=http://parallax:8100

# Ports publiés sur l'hôte. Ne concernent QUE `docker-compose.yml` (local) :
# le compose Dokploy ne publie aucun port, c'est son Traefik qui route. Le port
# du parallaxe n'y sert qu'au debug (curl direct) — le studio le joint par le
# réseau interne, pas par ce port.
STUDIO_PORT=3000
PARALLAX_PORT=8100
