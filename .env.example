# Copier en `.env` (lu automatiquement par docker compose) ou poser ces
# variables dans l'onglet Environment de Dokploy.
#
# Toutes ont un défaut adapté au local dans `docker-compose.yml`. En revanche,
# `docker-compose.dokploy.yml` exige PARALLAX_PUBLIC_URL et STUDIO_PUBLIC_ORIGINS :
# un repli sur localhost y donnerait un studio dont le panneau parallaxe échoue
# chez chaque visiteur.

# URL publique du service parallaxe, telle que le NAVIGATEUR la joint.
# Elle est figée dans le bundle du studio au build : la changer impose de
# reconstruire le studio (`docker compose up --build studio`).
PARALLAX_PUBLIC_URL=http://localhost:8100

# Origines depuis lesquelles le studio est ouvert, autorisées par le CORS du
# parallaxe. Plusieurs valeurs séparées par des virgules.
STUDIO_PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ports publiés sur l'hôte. Ne concernent QUE `docker-compose.yml` (local) :
# le compose Dokploy ne publie aucun port, c'est son Traefik qui route.
STUDIO_PORT=3000
PARALLAX_PORT=8100
